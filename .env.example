# ==========================================
# Configuración del Backend (Agente)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8001
DEBUG_MODE=True

# ==========================================
# Autenticación y Seguridad
# ==========================================
# Si se deja vacío API_SECRET_KEY="", el agente generará una contraseña aleatoria automáticamente al arrancar.
API_SECRET_KEY=""

# ==========================================
# Docker
# ==========================================
# En Linux, usualmente se deja vacío porque usa unix:///var/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock

# ==========================================
# Telemetría del sistema (opcional)
# ==========================================
# Todos los valores se detectan automáticamente. Estas variables solo son
# necesarias si deseas forzar un valor concreto (por ejemplo, tras un proxy).
# SYSTEM_OS="Ubuntu 22.04.3 LTS (Docker Engine)"
# HOST_ARCH=x86_64
# PROTECTED_PORTS="443:HTTPS,8443:WSS"
# ZERO_TRUST_TUNNEL="Cloudflare Tunnel (HTTPS/WSS)"
# Ruta alternativa a un archivo os-release del host montado dentro del contenedor.
# HOST_OS_RELEASE=/host/etc/os-release
#