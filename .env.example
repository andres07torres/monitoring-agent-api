# ==========================================
# Configuración del Backend (Agente)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8001
DEBUG_MODE=True

# ==========================================
# Autenticación y Seguridad
# ==========================================
# Si se deja vacío API_SECRET_KEY="", el agente generará una contraseña aleatoria automáticamente al arrancar.
API_SECRET_KEY=""

# ==========================================
# Docker
# ==========================================
# En Linux, usualmente se deja vacío porque usa unix:///var/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock
#