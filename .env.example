# ==========================================
# Configuración del Backend (Agente)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8001
DEBUG_MODE=True

# ==========================================
# Autenticación y Seguridad
# ==========================================
# Genera una clave segura y pégala aquí. Esta misma clave deberá ingresarse en la app móvil.
API_SECRET_KEY=cambiar_por_una_llave_segura_generada_aleatoriamente

# ==========================================
# Docker
# ==========================================
# En Linux, usualmente se deja vacío porque usa unix:///var/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock
